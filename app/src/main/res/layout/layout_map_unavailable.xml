<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet-first empty state when campus has no mosaic map (Mithril "Map is Unavailable"). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/map_unavailable"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_map_unavailable"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageButton
        android:id="@+id/btn_unavailable_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_map_chrome"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_map_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="560dp">

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_map_unavailable_icon">

            <ImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_no_map" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="@font/titilliumweb_bold"
            android:gravity="center"
            android:text="@string/map_unavailable_title"
            android:textColor="@color/md_primary"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/unavailable_campus_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/titilliumweb_semibold"
            android:gravity="center"
            android:textColor="@color/md_orange"
            android:textSize="18sp"
            tools:text="India Team Campus" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/titilliumweb_regular"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/map_unavailable_body"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unavailable_home"
            style="@style/Widget.Drone.Button.Orange"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:text="@string/map_unavailable_cta" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
