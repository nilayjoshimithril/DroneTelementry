<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.DroneTelementryPOC" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_secondary</item>
        <item name="colorSecondary">@color/md_orange</item>
        <item name="colorOnSecondary">@color/md_secondary</item>
        <item name="colorError">@color/md_red</item>
        <item name="android:statusBarColor">@color/md_secondary</item>
        <item name="android:navigationBarColor">@color/md_secondary</item>
        <item name="android:windowBackground">@color/md_secondary</item>
        <item name="android:fontFamily">@font/titillium_web</item>
        <item name="fontFamily">@font/titillium_web</item>
    </style>

    <style name="Theme.DroneTelementryPOC" parent="Base.Theme.DroneTelementryPOC" />

    <style name="Theme.DroneTelementryPOC.Splash" parent="Theme.DroneTelementryPOC">
        <item name="android:windowBackground">@color/md_secondary</item>
    </style>

    <style name="Widget.Drone.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_secondary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">@font/titillium_web</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Drone.Button.Orange" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_orange</item>
        <item name="android:textColor">@color/md_secondary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">@font/titillium_web</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Drone.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/md_primary</item>
        <item name="android:fontFamily">@font/titillium_web</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Drone.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/titilliumweb_bold</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <style name="TextAppearance.Drone.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/titilliumweb_regular</item>
        <item name="android:textColor">@color/md_hint</item>
    </style>
</resources>
