<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Used by MainActivity on 401 — must be an action id (Navigation 2.8+
         treats navigate(R.id.fragment) as a typed route and crashes). -->
    <action
        android:id="@+id/action_global_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true"
        app:launchSingleTop="true" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.guardianangel.dronetelementry.presentation.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.guardianangel.dronetelementry.presentation.onboarding.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.guardianangel.dronetelementry.presentation.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.guardianangel.dronetelementry.presentation.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_zoom_campuses"
            app:destination="@id/zoomCampusListFragment" />
    </fragment>

    <fragment
        android:id="@+id/zoomCampusListFragment"
        android:name="com.guardianangel.dronetelementry.presentation.settings.ZoomCampusListFragment"
        android:label="Map zoom level"
        tools:layout="@layout/fragment_zoom_campuses">
        <action
            android:id="@+id/action_zoom_campuses_to_preview"
            app:destination="@id/zoomPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/zoomPreviewFragment"
        android:name="com.guardianangel.dronetelementry.presentation.settings.ZoomPreviewFragment"
        android:label="Zoom preview"
        tools:layout="@layout/fragment_zoom_preview">
        <argument
            android:name="campusId"
            app:argType="string" />
        <argument
            android:name="campusName"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
</navigation>
