<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_secondary">

    <com.guardianangel.mithrildefense.map.MosaicMapView
        android:id="@+id/mosaic_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/side_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/map_chrome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_chrome"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_map_back" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/building_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_map_chrome"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/campus_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_hint"
                    android:textSize="11sp"
                    tools:text="India Team Campus" />

                <TextView
                    android:id="@+id/building_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Outdoor Map" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buildings"
                android:textColor="@color/md_orange"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/floor_dropdown_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/floor"
            app:boxBackgroundColor="#CC0E0F13"
            app:boxStrokeColor="@color/md_hint"
            app:hintTextColor="@color/md_hint">

            <AutoCompleteTextView
                android:id="@+id/floor_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/md_primary"
                tools:text="Outdoor" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/building_picker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/md_secondary"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/side_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_picker_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_chrome"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_map_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/select_building"
                android:textColor="@color/md_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/picker_campus_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/md_hint"
            android:textSize="14sp"
            tools:text="India Team Campus" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/building_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_building" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/side_panel"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="#F00E0F13"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/titilliumweb_bold"
                android:text="@string/drones"
                android:textColor="@color/md_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/socket_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_turquoise"
                android:textSize="13sp"
                tools:text="Live" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drone_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_leave"
            style="@style/Widget.Drone.Button.Orange"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/leave_session" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/md_orange"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/mosaic_map"
        app:layout_constraintEnd_toEndOf="@id/mosaic_map"
        app:layout_constraintStart_toStartOf="@id/mosaic_map"
        app:layout_constraintTop_toTopOf="@id/mosaic_map" />

    <TextView
        android:id="@+id/error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/md_red"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/mosaic_map"
        app:layout_constraintEnd_toEndOf="@id/mosaic_map"
        app:layout_constraintStart_toStartOf="@id/mosaic_map"
        app:layout_constraintTop_toTopOf="@id/mosaic_map" />

    <include
        android:id="@+id/map_unavailable_panel"
        layout="@layout/layout_map_unavailable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
