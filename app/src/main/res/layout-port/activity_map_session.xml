<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_secondary">

    <!-- Map always fills the screen; the drone panel slides over it as an overlay. -->
    <com.guardianangel.dronetelementry.map.MosaicMapView
        android:id="@+id/mosaic_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/map_chrome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_chrome"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_map_back" />

            <!-- Incident header: campus name + live running time. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/incident_header"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_map_chrome"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:id="@+id/incident_campus_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/titilliumweb_bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/md_primary"
                        android:textSize="15sp"
                        tools:text="India Team Campus" />

                    <LinearLayout
                        android:id="@+id/incident_running_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_running_dot" />

                        <TextView
                            android:id="@+id/incident_running_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/md_hint"
                            android:textSize="12sp"
                            tools:text="Running 00:12:34" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Hides / shows the drone list panel. Arrow points where the panel goes. -->
            <LinearLayout
                android:id="@+id/btn_toggle_drones"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_chrome"
                android:clickable="true"
                android:contentDescription="@string/collapse_drones"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/titilliumweb_bold"
                    android:text="@string/drones"
                    android:textColor="@color/md_primary"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/toggle_drones_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:rotation="0"
                    android:scaleType="center"
                    android:src="@drawable/ic_expand_chevron"
                    app:tint="@color/md_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Building selector with the floor selector beside it. -->
        <LinearLayout
            android:id="@+id/building_floor_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/building_header"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_map_chrome"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/building_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/md_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Outdoor Map" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buildings"
                    android:textColor="@color/md_orange"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/floor_dropdown_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="@string/floor"
                app:boxBackgroundColor="#CC0E0F13"
                app:boxStrokeColor="@color/md_hint"
                app:hintTextColor="@color/md_hint">

                <AutoCompleteTextView
                    android:id="@+id/floor_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/md_primary"
                    tools:text="Outdoor" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/building_picker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/md_secondary"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/side_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_picker_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_map_chrome"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_map_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/select_building"
                android:textColor="@color/md_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/picker_campus_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/md_hint"
            android:textSize="14sp"
            tools:text="India Team Campus" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/building_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_building" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/side_panel"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="#F00E0F13"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/titilliumweb_bold"
                android:text="@string/drones"
                android:textColor="@color/md_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/socket_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_turquoise"
                android:textSize="13sp"
                tools:text="Live" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drone_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_leave"
            style="@style/Widget.Drone.Button.Orange"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/leave_session" />
    </LinearLayout>


    <!-- Mithril MapThreatOverlay: "Nth Threat Identified" — tap to locate, X to hide. -->
    <LinearLayout
        android:id="@+id/threat_banner"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_threat_banner"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map_chrome"
        tools:visibility="visible">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_threat_marker" />

        <TextView
            android:id="@+id/threat_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/titilliumweb_bold"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="1st Threat Identified" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:rotation="-90"
            android:src="@drawable/ic_expand_chevron"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/threat_banner_dismiss"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/threat_banner_dismiss"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/md_hint" />
    </LinearLayout>

    <!-- Mithril locate-threat MapActionIcon: one threat → focus it, several → pick from list. -->
    <FrameLayout
        android:id="@+id/locate_threat_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/side_panel"
        app:layout_constraintEnd_toEndOf="@id/mosaic_map"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/btn_locate_threat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_locate_threat"
            android:contentDescription="@string/locate_threat"
            android:foreground="?attr/selectableItemBackground"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_map_locate_threat" />

        <TextView
            android:id="@+id/threat_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="-6dp"
            android:background="@drawable/bg_threat_badge"
            android:gravity="center"
            android:minWidth="16dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="3" />
    </FrameLayout>

    <!-- Navigation view toggle: Google-Maps-style 45° tilted, heading-up camera. -->
    <ImageButton
        android:id="@+id/btn_nav_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_map_chrome"
        android:contentDescription="@string/navigation_view"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_nav_view"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/locate_threat_container"
        app:layout_constraintEnd_toEndOf="@id/mosaic_map"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/md_orange"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/mosaic_map"
        app:layout_constraintEnd_toEndOf="@id/mosaic_map"
        app:layout_constraintStart_toStartOf="@id/mosaic_map"
        app:layout_constraintTop_toTopOf="@id/mosaic_map" />

    <TextView
        android:id="@+id/error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/md_red"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/mosaic_map"
        app:layout_constraintEnd_toEndOf="@id/mosaic_map"
        app:layout_constraintStart_toStartOf="@id/mosaic_map"
        app:layout_constraintTop_toTopOf="@id/mosaic_map" />

    <include
        android:id="@+id/map_unavailable_panel"
        layout="@layout/layout_map_unavailable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
